{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.0.0",
	"FriendlyName": "NexusLink",
	"Description": "MCP (Model Context Protocol) server for Unreal Engine. Module Type is Runtime for Game/Server link compatibility; Startup/Shutdown no-op when !WITH_EDITOR — MCP only runs in Editor / PIE. Platform gating is declared twice on purpose: PlatformAllowList (UE5) and WhitelistPlatforms (UE4.2x) — UE4 ignores the UE5 key entirely, so dropping it would link the module into mobile clients.",
	"Category": "Developer Tools",
	"CreatedBy": "byteyang",
	"CreatedByURL": "https://github.com/bytepine",
	"DocsURL": "https://github.com/bytepine/NexusLink/blob/master/README.en.md",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/bytepine/NexusLink/issues",
	"EngineVersion": "4.26",
	"CanContainContent": false,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "NexusLink",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64",
				"Mac"
			],
			"WhitelistPlatforms": [
				"Win64",
				"Mac"
			]
		},
		{
			"Name": "NexusLinkTests",
			"Type": "DeveloperTool",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64",
				"Mac"
			],
			"WhitelistPlatforms": [
				"Win64",
				"Mac"
			]
		}
	],
	"Plugins": [
		{
			"Name": "WebSocketNetworking",
			"Enabled": true
		},
		{
			"Name": "GameplayAbilities",
			"Enabled": true
		},
		{
			"Name": "Niagara",
			"Enabled": true
		}
	]
}
